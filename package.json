  },
  "dependencies": {
    "discord.js": "^11.5.1",
    "pg": "^7.18.2",
    "socket.io": "^2.3.0"
  },
  "devDependencies": {
    "mocha": "^7.1.0",
    "nyc": "^15.0.0"
  }
}
