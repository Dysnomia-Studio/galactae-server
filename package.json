{
  "name": "galactae-server",
  "description": "NodeJs Server for Galactae",
  "author": "Elanis",
  "main": "app.js",
  "scripts": {
    "start-old": "pm2 start ecosystem.config.js",
    "start": "node app.js",
    "dev-start": "node --trace-uncaught app.js",
    "test": "nyc --reporter=lcov --reporter=text-summary --report-dir reports/ npm run tests",
    "tests": "mocha test --exit --require ./test/__include --recursive --color",
    "test-watch": "mocha test/**/*.js --color --watch"
  },
  "dependencies": {
    "discord.js": "^14.22.1",
    "pg": "^8.16.3",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "mocha": "^11.7.1",
    "nyc": "^17.1.0"
  }
}
